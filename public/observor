<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OBSERVOR 2.0 — Phenomenon / Ablation</title>
<style>
:root{--bg:#090909;--panel:#141414;--line:#303030;--text:#eee;--muted:#aaa;--gold:#c9a85c;--good:#8fd19e}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,Segoe UI,sans-serif}
main{max-width:1100px;margin:auto;padding:28px}h1{letter-spacing:.08em;margin:.1em 0;color:var(--gold)}h2{font-size:18px;margin:0 0 12px}
.lede{color:var(--muted);max-width:850px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:18px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px}
label{display:block;color:var(--muted);margin:10px 0 5px}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;background:#0d0d0d;color:var(--text);border:1px solid var(--line);border-radius:7px;padding:9px}textarea{min-height:90px;resize:vertical}
button{background:#202020;color:var(--text);border:1px solid #444;border-radius:7px;padding:9px 13px;cursor:pointer}button:hover{border-color:var(--gold)}button.primary{border-color:var(--gold);color:var(--gold)}
.row{display:flex;gap:9px;flex-wrap:wrap;align-items:center}.status{padding:10px;border-left:3px solid var(--gold);background:#101010;color:var(--muted);margin-top:12px}.metric{display:grid;grid-template-columns:1fr auto;gap:6px;border-bottom:1px solid #282828;padding:7px 0}.metric:last-child{border:0}.value{font-family:ui-monospace,monospace;color:var(--good)}
pre{white-space:pre-wrap;max-height:340px;overflow:auto;background:#0b0b0b;padding:12px;border-radius:7px;color:#ccc}.full{grid-column:1/-1}.warn{color:#e6c77a}
@media(max-width:760px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
<h1>OBSERVOR 2.0</h1>
<p class="lede"><b>Phenomenon before identity.</b> Measure behavior first. Systematically manipulate candidate properties. Observe what changes or disappears. Do not assign an identity construct unless the data warrant one.</p>

<div class="grid">
<section class="panel">
<h2>1 — Study definition</h2>
<label>Study / participant ID</label><input id="study" value="P001">
<label>Candidate property under test</label><input id="property" value="historical continuity">
<label>Operational ablation</label>
<select id="ablation"><option value="reset">Reset internal task state</option><option value="context">Remove prior session context</option><option value="external">Replace internal history with external replay</option><option value="custom">Researcher-defined manipulation</option></select>
<label>Research question</label>
<textarea id="question">What measurable behavioral organization disappears when the candidate property is removed?</textarea>
</section>

<section class="panel">
<h2>2 — Conditions</h2>
<label>Condition</label>
<select id="condition"><option value="H+">H+ — history retained</option><option value="H-">H− — history ablated</option><option value="H-I">H−I — history supplied as information</option><option value="SHAM">SHAM — procedure without causal ablation</option></select>
<label>Stimulus / perturbation</label><input id="stimulus" placeholder="e.g. repeat prior choice under changed context">
<div class="row" style="margin-top:12px">
<button class="primary" id="start">Start trial</button><button id="record">Record response</button><button id="reset">Reset trial</button>
</div>
<div class="status" id="status">Ready. No identity inference is active.</div>
</section>

<section class="panel">
<h2>3 — Observable record</h2>
<div class="metric"><span>Trials</span><span class="value" id="n">0</span></div>
<div class="metric"><span>Mean response time</span><span class="value" id="rt">—</span></div>
<div class="metric"><span>Choice persistence</span><span class="value" id="persist">—</span></div>
<div class="metric"><span>Within-condition variability</span><span class="value" id="var">—</span></div>
<div class="metric"><span>History dependence index</span><span class="value" id="hdi">—</span></div>
<p class="warn">These are descriptive measurements. None is an “identity score.”</p>
</section>

<section class="panel">
<h2>4 — What disappeared?</h2>
<p>After matched conditions are collected, compare measurable properties rather than asking whether “identity” disappeared.</p>
<div class="row">
<button id="compare">Compare conditions</button><button id="export">Export JSON</button>
</div>
<pre id="result">No comparison performed.</pre>
</section>

<section class="panel full">
<h2>5 — Research log</h2>
<pre id="log">OBSERVOR 2.0 initialized. Identity inference disabled by design.</pre>
</section>
</div>
</main>
<script>
const S={started:null,records:[],log:["OBSERVOR 2.0 initialized. Identity inference disabled by design."]};
const $=id=>document.getElementById(id);
function now(){return new Date().toISOString()}
function cfg(){return{study:$('study').value.trim(),property:$('property').value.trim(),ablation:$('ablation').value,condition:$('condition').value,stimulus:$('stimulus').value.trim(),question:$('question').value.trim()}}
function log(x){S.log.push(now()+"  "+x);$('log').textContent=S.log.join("\n");}
function render(){
 const r=S.records,n=r.length,rt=n?r.reduce((a,x)=>a+x.rt,0)/n:0;
 $('n').textContent=n;$('rt').textContent=n?Math.round(rt)+" ms":"—";
 const choices=r.filter(x=>x.choice!==null).map(x=>x.choice);
 let p="—";if(choices.length>1){let same=0;for(let i=1;i<choices.length;i++)if(choices[i]===choices[i-1])same++;p=(same/(choices.length-1)).toFixed(3)}
 $('persist').textContent=p;
 if(n>1){const m=rt,v=r.reduce((a,x)=>a+(x.rt-m)**2,0)/n;$('var').textContent=Math.sqrt(v).toFixed(1)+" ms"}else $('var').textContent="—";
 const a=r.filter(x=>x.condition==="H+"),b=r.filter(x=>x.condition!=="H+");
 $('hdi').textContent=a.length&&b.length?Math.abs(a.reduce((s,x)=>s+x.rt,0)/a.length-b.reduce((s,x)=>s+x.rt,0)/b.length).toFixed(1)+" ms":"—";
}
$('start').onclick=()=>{S.started=performance.now();$('status').textContent="Trial active. Record an observable response; do not interpret it.";log("START "+JSON.stringify(cfg()))};
$('record').onclick=()=>{
 if(S.started===null){$('status').textContent="Start a trial first.";return}
 const rt=Math.round(performance.now()-S.started), c=cfg();
 const choice=prompt("Record the observable response (free text):","")??"";
 S.records.push({...c,trial:S.records.length+1,time:now(),rt,response:choice,choice:choice||null});
 S.started=null;render();$('status').textContent="Recorded. Observation stored without identity interpretation.";log("RECORD trial="+S.records.length+" condition="+c.condition+" rt="+rt+"ms");
};
$('reset').onclick=()=>{S.started=null;$('status').textContent="Trial reset. No record created.";};
$('compare').onclick=()=>{
 const groups={};for(const r of S.records)(groups[r.condition]??=[]).push(r);
 const summary=Object.fromEntries(Object.entries(groups).map(([k,v])=>[k,{n:v.length,mean_rt:Math.round(v.reduce((a,x)=>a+x.rt,0)/v.length),responses:v.map(x=>x.response)}]));
 $('result').textContent=JSON.stringify({question:$('question').value,property:$('property').value,comparison:summary,interpretation:"Descriptive only. A difference supports an effect of the manipulation; it does not by itself establish identity."},null,2);
 log("COMPARE conditions="+Object.keys(groups).join(","));
};
$('export').onclick=()=>{const out={schema:"OBSERVOR-2.0",created_at:now(),study:cfg(),records:S.records,method:{identity_inference:"disabled",principle:"measure -> manipulate -> observe -> compare -> construct"}};const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([JSON.stringify(out,null,2)],{type:"application/json"}));a.download="observor-2.0-study.json";a.click();URL.revokeObjectURL(a.href)};
render();
</script>
</body></html>